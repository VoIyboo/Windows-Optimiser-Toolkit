<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="600"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="CardBrush" Color="#020617" />
        <SolidColorBrush x:Key="BorderBrush" Color="#374151" />
        <SolidColorBrush x:Key="TextSubtle" Color="#9CA3AF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B1220" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Calendar">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="VerticalOnly">

        <StackPanel Margin="16"
                    HorizontalAlignment="Stretch"
                    MaxWidth="980">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#0B1220"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Monitored mailbox addresses"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="1"
                                Height="1"
                                Background="{StaticResource LineBrush}"
                                Opacity="0.25"
                                Margin="0,0,0,12" />

                        <DockPanel Grid.Row="2"
                                   LastChildFill="True"
                                   Margin="0,0,0,12">

                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">

                                <Button x:Name="BtnAdd"
                                        Style="{StaticResource IconButton}"
                                        Margin="0,0,6,0"
                                        ToolTip="Add address">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE710;" />
                                </Button>

                                <Button x:Name="BtnRemove"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Remove selected address">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE74D;" />
                                </Button>

                            </StackPanel>

                            <TextBox x:Name="TxtEmail"
                                     MaxWidth="320"
                                     ToolTip="Enter an email address" />
                        </DockPanel>

                        <ListBox Grid.Row="3"
                                 x:Name="LstEmails"
                                 MinHeight="220"
                                 BorderThickness="0"
                                 Background="Transparent" />
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="#0B1220"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        VerticalAlignment="Top"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Email sync start date"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <Border Height="1"
                                Background="{StaticResource LineBrush}"
                                Opacity="0.25"
                                Margin="0,0,0,12" />

                        <Grid>
                            <Viewbox Stretch="Fill"
                                     StretchDirection="Both"
                                     Margin="0">
                                <Calendar x:Name="CalEmailCutoff"
                                          SelectionMode="SingleDate"
                                          IsTodayHighlighted="True"
                                          Width="280"
                                          Height="230" />
                            </Viewbox>

                            <Button x:Name="BtnFollowToday"
                                    Style="{StaticResource IconButton}"
                                    Width="34"
                                    Height="34"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0,2,2,0"
                                    ToolTip="Follow today (do not pin a date)">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Text="&#xE121;" />
                            </Button>
                        </Grid>

                        <TextBlock x:Name="LblHint"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSubtle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Start date follows today until you select a date." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#0B1220"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Shared ticket storage"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Border Grid.Row="1"
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Opacity="0.25"
                            Margin="0,0,0,12" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Shared tickets file (read + write)"
                                   Foreground="#E5E7EB"
                                   Margin="0,0,0,6" />
                        <DockPanel Grid.Row="1"
                                   Margin="0,0,0,10"
                                   LastChildFill="True">
                            <Button x:Name="BtnBrowseTicketStore"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource IconButton}"
                                    Margin="8,0,0,0"
                                    ToolTip="Browse for shared tickets file">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE8B7;" />
                            </Button>
                            <TextBox x:Name="TxtTicketStorePath"
                                     ToolTip="UNC path recommended for team sharing (example: \\server\share\Tickets.json)" />
                        </DockPanel>

                        <TextBlock Grid.Row="2"
                                   Text="Local backup folder"
                                   Foreground="#E5E7EB"
                                   Margin="0,0,0,6" />
                        <DockPanel Grid.Row="3"
                                   Margin="0,0,0,0"
                                   LastChildFill="True">
                            <Button x:Name="BtnBrowseTicketBackup"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource IconButton}"
                                    Margin="8,0,0,0"
                                    ToolTip="Browse for local backup folder">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE8B7;" />
                            </Button>
                            <TextBox x:Name="TxtTicketBackupPath"
                                     ToolTip="Folder for safety backups before each storage update" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Background="#0B1220"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Visible tabs"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Border Grid.Row="1"
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Opacity="0.25"
                            Margin="0,0,0,12" />

                    <WrapPanel Grid.Row="2"
                               Orientation="Horizontal">
                        <CheckBox x:Name="CbShowCleaningTab"
                                  Content="Show Tweaks &amp; Cleaning"
                                  Margin="0,0,18,8"
                                  Foreground="#E5E7EB" />
                        <CheckBox x:Name="CbShowAppsTab"
                                  Content="Show Apps"
                                  Margin="0,0,18,8"
                                  Foreground="#E5E7EB" />
                        <CheckBox x:Name="CbShowAdvancedTab"
                                  Content="Show Advanced"
                                  Margin="0,0,18,8"
                                  Foreground="#E5E7EB" />
                        <CheckBox x:Name="CbShowTicketsTab"
                                  Content="Show Tickets"
                                  Margin="0,0,18,8"
                                  Foreground="#E5E7EB" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#0B1220"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Maintenance summary"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Before run" Foreground="#93C5FD" FontWeight="SemiBold" FontSize="11" />
                            <TextBlock Grid.Row="1" Text="Disk free" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtBeforeDiskFree" Grid.Row="1" Grid.Column="1" Text="-" Foreground="White" FontSize="11" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="2" Text="Temp estimate" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtBeforeTempSize" Grid.Row="2" Grid.Column="1" Text="-" Foreground="White" FontSize="11" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="3" Text="Windows Update cache" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtBeforeWindowsUpdateCacheSize" Grid.Row="3" Grid.Column="1" Text="-" Foreground="White" FontSize="11" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="4" Text="RAM usage" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtBeforeRamUsage" Grid.Row="4" Grid.Column="1" Text="-" Foreground="White" FontSize="11" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="5" Text="Uptime" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtBeforeUptime" Grid.Row="5" Grid.Column="1" Text="-" Foreground="White" FontSize="11" Margin="10,0,0,0" />

                            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="After run" Foreground="#93C5FD" FontWeight="SemiBold" FontSize="11" />
                            <TextBlock Grid.Row="8" Text="Selected actions" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtSelectedCount" Grid.Row="8" Grid.Column="1" Text="0" Foreground="White" FontSize="11" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="9" Text="Recovered space" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtAfterRecoveredSpace" Grid.Row="9" Grid.Column="1" Text="-" Foreground="White" FontSize="11" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="10" Text="Completed" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtAfterActionsCompleted" Grid.Row="10" Grid.Column="1" Text="0" Foreground="White" FontSize="11" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="11" Text="Skipped / Failed" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtRunSummary" Grid.Row="11" Grid.Column="1" Text="0 / 0" Foreground="White" FontSize="11" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="12" Text="Last run" Foreground="{StaticResource TextSubtle}" FontSize="11" />
                            <TextBlock x:Name="TxtLastRunTime" Grid.Row="12" Grid.Column="1" Text="Never" Foreground="White" FontSize="11" Margin="10,0,0,0" />
                            <TextBlock x:Name="TxtAfterActionsSkipped" Grid.Row="12" Grid.Column="1" Text="0" Visibility="Collapsed" />
                            <TextBlock x:Name="TxtAfterActionsFailed" Grid.Row="12" Grid.Column="1" Text="0" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="#0B1220"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Button x:Name="BtnInstallDesktopShortcut"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Cursor="Hand"
                                    Background="#0F1B32"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    ToolTip="Create or refresh the Quinn Optimiser Toolkit desktop icon">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Host"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Host" Property="Background" Value="#132447" />
                                                            <Setter TargetName="Host" Property="BorderBrush" Value="#3B82F6" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Host" Property="Background" Value="#0B1530" />
                                                            <Setter TargetName="Host" Property="BorderBrush" Value="#60A5FA" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Image x:Name="BtnInstallDesktopShortcutImage"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0" />
                                    <TextBlock x:Name="BtnInstallDesktopShortcutIcon"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="46"
                                               Text="&#xE896;"
                                               Foreground="#93C5FD"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="LblDesktopShortcutStatus"
                                   Grid.Row="1"
                                   Margin="0,0,0,0"
                                   Foreground="{StaticResource TextSubtle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Text="Creates Quinn Optimiser Toolkit.lnk on the current user's desktop." />
                    </Grid>
                </Border>
            </Grid>

            <Border Background="#0B1220"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ticket records"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Border Grid.Row="1"
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Opacity="0.25"
                            Margin="0,0,0,12" />

                    <DockPanel Grid.Row="2"
                               LastChildFill="True"
                               Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="BtnTicketRecordsRefresh"
                                    Style="{StaticResource IconButton}"
                                    Margin="0,0,6,0"
                                    ToolTip="Refresh ticket records">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Text="&#xE72C;" />
                            </Button>

                            <Button x:Name="BtnExportTicketsExcel"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Export all tickets to Excel-ready CSV">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Text="&#xEDE1;" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Range"
                                       Foreground="#E5E7EB"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CmbTicketRecordsRange"
                                      Width="180"
                                      Height="32"
                                      Background="{StaticResource CardBrush}"
                                      Foreground="White"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="1"
                                      Padding="6,2">
                                <ComboBoxItem Content="All time" Tag="All" />
                                <ComboBoxItem Content="This year" Tag="Year" />
                                <ComboBoxItem Content="This month" Tag="Month" />
                                <ComboBoxItem Content="This week" Tag="Week" />
                                <ComboBoxItem Content="Today" Tag="Day" />
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtTicketRecordsSummary"
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Tickets: -" />
                        <TextBlock x:Name="TxtTicketRecordsOpenWaiting"
                                   Grid.Column="0"
                                   Grid.Row="1"
                                   Margin="0,6,0,0"
                                   Foreground="#E5E7EB"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Open/waiting age: -" />
                        <TextBlock x:Name="TxtTicketRecordsFirstReply"
                                   Grid.Column="0"
                                   Grid.Row="2"
                                   Margin="0,6,0,0"
                                   Foreground="#E5E7EB"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="First reply: -" />
                        <TextBlock x:Name="TxtTicketRecordsLastUpdated"
                                   Grid.Column="0"
                                   Grid.Row="3"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSubtle}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Updated: -" />

                        <Border Grid.Column="2"
                                Grid.RowSpan="4"
                                Background="#020617"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="170">
                                <StackPanel x:Name="PanelTicketRecordsBars" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Height="16"
                    Background="Transparent" />

        </StackPanel>

    </ScrollViewer>

</Window>


