                                <Trigger Property="Tag" Value="Invoke-QCleanPrefetchFiles"><Setter Property="ToolTip" Value="Safe: removes outdated application launch trace files." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QRefreshWindowsIconCache"><Setter Property="ToolTip" Value="Safe: rebuilds icon cache to fix missing or incorrect icons." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QClearWindowsEventLogs"><Setter Property="ToolTip" Value="Safe: removes stored Windows diagnostic and event logs." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QCleanTeamsCache"><Setter Property="ToolTip" Value="Safe: clears Teams cache to fix common loading and sign-in issues." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakStartMenuRecommendations"><Setter Property="ToolTip" Value="Reduce Start menu recommendations and suggested content." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakSuggestedApps"><Setter Property="ToolTip" Value="Disable suggested apps and promotional app suggestions." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakTipsInStart"><Setter Property="ToolTip" Value="Disable tips and hints shown in Start." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakBingSearch"><Setter Property="ToolTip" Value="Disable Bing and web results in Start search." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakClassicContextMenu"><Setter Property="ToolTip" Value="Use the classic right-click context menu style." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakWidgets"><Setter Property="ToolTip" Value="Disable taskbar Widgets panel integration." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakNewsAndInterests"><Setter Property="ToolTip" Value="Disable News and Interests style taskbar content." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakMeetNow"><Setter Property="ToolTip" Value="Hide legacy Meet Now taskbar entry." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakAdvertisingId"><Setter Property="ToolTip" Value="Disable per-user advertising identifier tracking." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakFeedbackHub"><Setter Property="ToolTip" Value="Reduce Windows feedback and survey prompts." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakOnlineTips"><Setter Property="ToolTip" Value="Disable online tips and suggestion hints." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakDisableLockScreenTips"><Setter Property="ToolTip" Value="Disable lock screen tips and spotlight extras." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakDisableSettingsSuggestedContent"><Setter Property="ToolTip" Value="Disable suggested content in Settings pages." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakDisableTransparencyEffects"><Setter Property="ToolTip" Value="Disable UI transparency effects for a flatter look." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakDisableStartupDelay"><Setter Property="ToolTip" Value="Remove startup delay for startup apps." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakDisableGameDVR"><Setter Property="ToolTip" Value="Safe: reduces background game capture features for better performance." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakDisableWindowsConsumerFeatures"><Setter Property="ToolTip" Value="Safe: stops Windows from reinstalling suggested consumer apps and promotions." /></Trigger>
                                <Trigger Property="Tag" Value="Invoke-QTweakDisableWindowsRecall"><Setter Property="ToolTip" Value="Safe: disables Recall screenshot tracking feature on supported systems." /></Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="CheckBox"
                               BasedOn="{StaticResource RichCheckRowStyle}" />
                    </TabItem.Resources>

                    <Grid Margin="5,10,5,5">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          IsDeferredScrollingEnabled="False"
                                          PanningMode="VerticalOnly">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Header="Cleaning &amp; Maintenance"
                                              Grid.Column="0"
                                              Margin="0"
                                              BorderThickness="0">
                                        <StackPanel Margin="4">

                                            <CheckBox x:Name="CbSectionStorageCleanup"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Storage cleanup"
                                                      ToolTip="Check every option in Storage cleanup" />
                                            <CheckBox x:Name="CbCleanTempFiles"
                                                      Tag="Invoke-QCleanTemp"
                                                      Content="Deep clean temporary folders" />
                                            <CheckBox x:Name="CbEmptyRecycleBin"
                                                      Tag="Invoke-QCleanRecycleBin"
                                                      Content="Empty Recycle Bin" />
                                            <CheckBox x:Name="CbCleanDoCache" Tag="Invoke-QCleanDOCache" Content="Clean Delivery Optimisation cache" />
                                            <CheckBox x:Name="CbCleanWuCache"
                                                      Tag="Invoke-QCleanWindowsUpdateCache"
                                                      Content="Clear Windows Update cache" />
                                            <CheckBox x:Name="CbCleanThumbCache" Tag="Invoke-QCleanThumbnailCache" Content="Clean thumbnail cache" />
                                            <CheckBox x:Name="CbCleanPrefetchFiles" Tag="Invoke-QCleanPrefetchFiles" Content="Clear Prefetch files" />
                                            <CheckBox x:Name="CbRefreshIconCache" Tag="Invoke-QRefreshWindowsIconCache" Content="Refresh Windows icon cache" />

                                            <Separator />

                                            <CheckBox x:Name="CbSectionWindowsHousekeeping"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Windows housekeeping"
                                                      ToolTip="Check every option in Windows housekeeping" />
                                            <CheckBox x:Name="CbCleanErrorLogs" Tag="Invoke-QCleanErrorLogs" Content="Clean old error logs and crash dumps" />
                                            <CheckBox x:Name="CbCleanSetupLeftovers" Tag="Invoke-QCleanSetupLeftovers" Content="Remove safe setup / upgrade leftovers" />
                                            <CheckBox x:Name="CbClearStoreCache" Tag="Invoke-QCleanStoreCache" Content="Clear Microsoft Store cache" />
                                            <CheckBox x:Name="CbClearEventLogs" Tag="Invoke-QClearWindowsEventLogs" Content="Clear Windows Event Logs" />
                                            <CheckBox x:Name="CbClearTeamsCache" Tag="Invoke-QCleanTeamsCache" Content="Clear Microsoft Teams cache" />

                                            <Separator />

                                            <CheckBox x:Name="CbSectionBrowserCleanup"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Browser cleanup (light)"
                                                      ToolTip="Check every option in Browser cleanup" />
                                            <CheckBox x:Name="CbEdgeLightCleanup" Tag="Invoke-QCleanEdgeCache" Content="Light clean of Microsoft Edge cache" />
                                            <CheckBox x:Name="CbChromeLightCleanup" Tag="Invoke-QCleanChromeCache" Content="Light clean of Chrome / Chromium cache" />
                                            <CheckBox x:Name="CbCleanDirectXShaderCache" Tag="Invoke-QCleanDirectXShaderCache" Content="Clear DirectX shader cache" />
                                            <CheckBox x:Name="CbCleanWERQueue" Tag="Invoke-QCleanWERQueue" Content="Clear Windows Error Reporting queue" />
                                            <CheckBox x:Name="CbClearClipboardHistory" Tag="Invoke-QCleanClipboardHistory" Content="Clear clipboard history" />
                                            <CheckBox x:Name="CbCleanExplorerRecentItems" Tag="Invoke-QCleanExplorerRecentItems" Content="Clear Explorer Recent items and Jump Lists" />
                                            <CheckBox x:Name="CbCleanWindowsSearchHistory" Tag="Invoke-QCleanWindowsSearchHistory" Content="Clear Windows Search history" />

                                        </StackPanel>
                                    </GroupBox>

                                    <Grid Grid.Column="1" />

                                    <GroupBox Grid.Column="2"
                                              Margin="0"
                                              BorderThickness="0">
                                        <GroupBox.Header>
                                            <Grid Height="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tweaks &amp; Privacy"
                                                           Foreground="White"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </GroupBox.Header>
                                        <StackPanel Margin="4">

                                            <CheckBox x:Name="CbSectionStartMenuRecommendations"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Start menu &amp; recommendations"
                                                      ToolTip="Check every option in Start menu &amp; recommendations" />
                                            <CheckBox x:Name="CbDisableStartRecommended" Tag="Invoke-QTweakStartMenuRecommendations" Content="Hide Start menu recommended items" />
                                            <CheckBox x:Name="CbDisableSuggestedApps" Tag="Invoke-QTweakSuggestedApps" Content="Turn off suggested apps and promotions" />
                                            <CheckBox x:Name="CbDisableTipsStart" Tag="Invoke-QTweakTipsInStart" Content="Disable tips and suggestions in Start" />
                                            <CheckBox x:Name="CbDisableBingSearch" Tag="Invoke-QTweakBingSearch" Content="Turn off Bing / web results in Start search" />
                                            <CheckBox x:Name="CbClassicMoreOptions" Tag="Invoke-QTweakClassicContextMenu" Content="Use classic 'More options' right-click menu" />

                                            <Separator />

                                            <CheckBox x:Name="CbSectionTaskbarWidgets"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Taskbar &amp; widgets"
                                                      ToolTip="Check every option in Taskbar &amp; widgets" />
                                            <CheckBox x:Name="CbDisableWidgets" Tag="Invoke-QTweakWidgets" Content="Turn off Widgets" />
                                            <CheckBox x:Name="CbDisableTaskbarNews" Tag="Invoke-QTweakNewsAndInterests" Content="Turn off News / taskbar content" />
                                            <CheckBox x:Name="CbDisableMeetNow" Tag="Invoke-QTweakMeetNow" Content="Hide legacy Meet Now button (if present)" />

                                            <Separator />

                                            <CheckBox x:Name="CbSectionPrivacyTelemetry"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Privacy &amp; telemetry (safe level)"
                                                      ToolTip="Check every option in Privacy &amp; telemetry" />
                                            <CheckBox x:Name="CbDisableAdvertisingId" Tag="Invoke-QTweakAdvertisingId" Content="Turn off advertising ID" />
                                            <CheckBox x:Name="CbLimitFeedbackPrompts" Tag="Invoke-QTweakFeedbackHub" Content="Reduce feedback and survey prompts" />
                                            <CheckBox x:Name="CbDisableOnlineTips" Tag="Invoke-QTweakOnlineTips" Content="Disable online tips and suggestions" />
                                            <CheckBox x:Name="CbDisableLockScreenTips" Tag="Invoke-QTweakDisableLockScreenTips" Content="Disable lock screen tips, suggestions, and spotlight extras" />
                                            <CheckBox x:Name="CbDisableSettingsSuggestedContent" Tag="Invoke-QTweakDisableSettingsSuggestedContent" Content="Disable Suggested content in Settings" />
                                            <CheckBox x:Name="CbDisableTransparencyEffects" Tag="Invoke-QTweakDisableTransparencyEffects" Content="Turn off transparency effects" />
                                            <CheckBox x:Name="CbDisableStartupDelay" Tag="Invoke-QTweakDisableStartupDelay" Content="Disable startup delay for startup apps" />

                                            <Separator />

                                            <CheckBox x:Name="CbSectionPerformanceTweaks"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Performance tweaks (safe)"
                                                      ToolTip="Check every option in Performance tweaks" />
                                            <CheckBox x:Name="CbDisableGameDVR" Tag="Invoke-QTweakDisableGameDVR" Content="Disable Game DVR" />
                                            <CheckBox x:Name="CbDisableWindowsConsumerFeatures" Tag="Invoke-QTweakDisableWindowsConsumerFeatures" Content="Disable Windows consumer features" />
                                            <CheckBox x:Name="CbDisableWindowsRecall" Tag="Invoke-QTweakDisableWindowsRecall" Content="Disable Windows Recall" />

                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Apps -->
                                <TabItem x:Name="TabApps" Header="Apps">
                    <TabItem.Resources>
                        <Style x:Key="AppRowSelectorCheck"
                               TargetType="CheckBox"
                               BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="Width" Value="18" />
                            <Setter Property="Height" Value="18" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="CheckHost"
                                                Width="18"
                                                Height="18"
                                                CornerRadius="3"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock x:Name="CheckGlyph"
                                                       Text="&#xE73E;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       Foreground="#60A5FA"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckHost" Property="Background" Value="#0B1F3B" />
                                                <Setter TargetName="CheckHost" Property="BorderBrush" Value="#2563EB" />
                                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CheckHost" Property="BorderBrush" Value="#60A5FA" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="CheckHost" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <DataTemplate x:Key="InstalledAppCheckRowContentTemplate">
                            <Border x:Name="InstalledAppRowCard"
                                    Background="#0B1220"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="56"
                                    Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding AppGlyph, TargetNullValue=&#xE71D;, FallbackValue=&#xE71D;}"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#93C5FD"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1"
                                                 Margin="2,0,0,0"
                                                 VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding InstallDateText}"
                                                   Foreground="{StaticResource TextSubtle}"
                                                   FontSize="11"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="InstalledStateGlyph"
                                               Grid.Column="2"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE73E;"
                                               FontSize="13"
                                               Foreground="#60A5FA"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=IsChecked}" Value="True">
                                    <Setter TargetName="InstalledAppRowCard" Property="Background" Value="#10233F" />
                                    <Setter TargetName="InstalledStateGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RiskLevel}" Value="Safe" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="InstalledAppRowCard" Property="BorderBrush" Value="#16A34A" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RiskLevel}" Value="Caution" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="InstalledAppRowCard" Property="BorderBrush" Value="#F59E0B" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RiskLevel}" Value="Advanced" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="InstalledAppRowCard" Property="BorderBrush" Value="#DC2626" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <DataTemplate x:Key="CommonAppCheckRowContentTemplate">
                            <Border x:Name="CommonAppRowCard"
                                    Background="#0B1220"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="56"
                                    Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding AppGlyph, TargetNullValue=&#xE71D;, FallbackValue=&#xE71D;}"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#93C5FD"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1"
                                                 Margin="2,0,0,0"
                                                 VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{StaticResource TextSubtle}"
                                                   FontSize="11"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="CommonStateGlyph"
                                               Grid.Column="2"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE73E;"
                                               FontSize="13"
                                               Foreground="#60A5FA"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=IsChecked}" Value="True">
                                    <Setter TargetName="CommonAppRowCard" Property="Background" Value="#10233F" />
                                    <Setter TargetName="CommonStateGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RiskLevel}" Value="Safe" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="CommonAppRowCard" Property="BorderBrush" Value="#16A34A" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RiskLevel}" Value="Caution" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="CommonAppRowCard" Property="BorderBrush" Value="#F59E0B" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RiskLevel}" Value="Advanced" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="CommonAppRowCard" Property="BorderBrush" Value="#DC2626" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsInstallable}" Value="False">
                                    <Setter TargetName="CommonAppRowCard" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <Style x:Key="AppInstalledCheckRowStyle"
                               TargetType="CheckBox"
                               BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="Margin" Value="0,3,0,3" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="ContentTemplate" Value="{StaticResource InstalledAppCheckRowContentTemplate}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="RowHost"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              RecognizesAccessKey="True" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowHost" Property="Background" Value="#091628" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="RowHost" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="ToolTip" Value="Queue this app for uninstall." />
                        </Style>

                        <Style x:Key="AppCommonCheckRowStyle"
                               TargetType="CheckBox"
                               BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="Margin" Value="0,3,0,3" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="ContentTemplate" Value="{StaticResource CommonAppCheckRowContentTemplate}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="RowHost"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              RecognizesAccessKey="True" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowHost" Property="Background" Value="#091628" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="RowHost" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="ToolTip" Value="Queue this app for install." />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="Already installed." />
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style x:Key="AppListGridStyle" TargetType="DataGrid">
                            <Setter Property="HeadersVisibility" Value="None" />
                            <Setter Property="GridLinesVisibility" Value="None" />
                            <Setter Property="CanUserResizeColumns" Value="False" />
                            <Setter Property="CanUserReorderColumns" Value="False" />
                            <Setter Property="CanUserSortColumns" Value="False" />
                            <Setter Property="RowHeaderWidth" Value="0" />
                            <Setter Property="SelectionMode" Value="Single" />
                            <Setter Property="SelectionUnit" Value="FullRow" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Margin" Value="0,4,0,0" />
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
                        </Style>

                        <Style x:Key="AppListRowStyle" TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style x:Key="AppListCellStyle" TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </TabItem.Resources>

                    <Grid Margin="5,10,5,5">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          IsDeferredScrollingEnabled="False"
                                          PanningMode="VerticalOnly">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Header="Installed apps"
                                              Grid.Column="0"
                                              Margin="0"
                                              BorderThickness="0">
                                        <Grid Margin="4">
                                            <DataGrid x:Name="AppsGrid"
                                                      Style="{StaticResource AppListGridStyle}"
                                                      RowStyle="{StaticResource AppListRowStyle}"
                                                      CellStyle="{StaticResource AppListCellStyle}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="False"
                                                      BorderBrush="{StaticResource BorderBrush}"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Focusable="False"
                                                                          IsHitTestVisible="True"
                                                                  Content="{Binding}"
                                                                          Tag="{Binding ActionId}"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Style="{StaticResource AppInstalledCheckRowStyle}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="Common app installs"
                                              Grid.Column="2"
