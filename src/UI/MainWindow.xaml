                                <Trigger Property="Name" Value="CbAdvRunSfcRepair"><Setter Property="ToolTip" Value="Safe: scans and repairs corrupted Windows system files." /></Trigger>
                                <Trigger Property="Name" Value="CbAdvRunDismHealthRepair"><Setter Property="ToolTip" Value="Safe: checks and repairs Windows image health store." /></Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="CheckBox"
                               BasedOn="{StaticResource AdvancedCheckRowStyle}" />
                    </TabItem.Resources>
                    <Grid Margin="5,10,5,5">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          IsDeferredScrollingEnabled="False"
                                          PanningMode="VerticalOnly">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Header="Advanced tweaks"
                                              Grid.Column="0"
                                              Margin="0"
                                              BorderThickness="0">
                                        <StackPanel Margin="4">
                                            <CheckBox x:Name="CbAdvSectionAppBrowserControls"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="App &amp; browser controls"
                                                      ToolTip="Check every option in App &amp; browser controls" />
                                            <CheckBox x:Name="CbAdvAdobeNetworkBlock" Content="Adobe network block" />
                                            <CheckBox x:Name="CbAdvBlockRazerInstalls" Content="Block Razer software installs" />
                                            <CheckBox x:Name="CbAdvBraveDebloat" Content="Brave debloat" />
                                            <CheckBox x:Name="CbAdvEdgeDebloat" Content="Edge debloat" />
                                            <CheckBox x:Name="CbAdvDisableEdge" Content="Disable Edge" />
                                            <CheckBox x:Name="CbAdvEdgeUninstallable" Content="Make Edge uninstallable via Settings" />

                                            <Separator />

                                            <CheckBox x:Name="CbAdvSectionSystemBehavior"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="System behavior"
                                                      ToolTip="Check every option in System behavior" />
                                            <CheckBox x:Name="CbAdvDisableBackgroundApps" Content="Disable background apps" />
                                            <CheckBox x:Name="CbAdvDisableFullscreenOptimizations" Content="Disable fullscreen optimizations" />
                                            <CheckBox x:Name="CbAdvDisableNotificationTray" Content="Disable notification tray/calendar" />
                                            <CheckBox x:Name="CbAdvDisplayPerformance" Content="Set display for performance" />

                                            <Separator />

                                            <CheckBox x:Name="CbAdvSectionAdvancedCleaning"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Advanced cleaning &amp; maintenance"
                                                      ToolTip="Check every option in Advanced cleaning &amp; maintenance" />
                                            <CheckBox x:Name="CbAdvRemoveOldProfiles" Content="Remove old profiles" />
                                            <CheckBox x:Name="CbAdvCleanComponentStore" Content="Clean Windows Component Store" />
                                            <CheckBox x:Name="CbAdvDisableTelemetryScheduledTasks" Content="Disable telemetry scheduled tasks" />
                                            <CheckBox x:Name="CbAdvScanUnusedDeviceDrivers" Content="Scan unused device drivers (report only)" />
                                            <CheckBox x:Name="CbAdvAggressiveRestoreCleanup" Content="Aggressive restore/log cleanup" />
                                            <CheckBox x:Name="CbAdvDeepCacheCleanup" Content="Deep cache/component store cleanup" />
                                            <CheckBox x:Name="CbAdvAggressiveComponentStoreCleanup" Content="Aggressive component store cleanup" />
                                        </StackPanel>
                                    </GroupBox>

                                    <Grid Grid.Column="1" />

                                                                        <GroupBox Grid.Column="2"
                                              Margin="0"
                                              BorderThickness="0">
                                        <GroupBox.Header>
                                            <Grid Height="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Network &amp; security"
                                                           Foreground="White"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </GroupBox.Header>
                                        <StackPanel Margin="4"> 
                                            <CheckBox x:Name="CbAdvSectionConnectivityControls"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Connectivity controls"
                                                      ToolTip="Check every option in Connectivity controls" />
                                            <CheckBox x:Name="CbAdvDisableIPv6" Content="Disable IPv6" />
                                            <CheckBox x:Name="CbAdvDisableTeredo" Content="Disable Teredo" />
                                            <CheckBox x:Name="CbAdvDisableCopilot" Content="Disable Microsoft Copilot" />
                                            <CheckBox x:Name="CbAdvDisableStorageSense" Content="Disable Storage Sense" />

                                            <Separator />

                                            <CheckBox x:Name="CbAdvSectionNetworkServiceTuning"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Network &amp; service tuning"
                                                      ToolTip="Check every option in Network &amp; service tuning" />
                                            <CheckBox x:Name="CbAdvNetworkReset" Content="Network reset" />
                                            <CheckBox x:Name="CbAdvRepairNetworkAdapter" Content="Repair network adapter" />
                                            <CheckBox x:Name="CbAdvServiceTuning" Content="Service tuning" />
                                            <CheckBox x:Name="CbAdvFlushDnsCache" Content="Flush DNS cache" />
                                            <CheckBox x:Name="CbAdvResetWinsock" Content="Reset Winsock" />
                                            <CheckBox x:Name="CbAdvResetWindowsFirewall" Content="Reset Windows Firewall" />

                                            <Separator />

                                            <CheckBox x:Name="CbAdvSectionRepairRecovery"
                                                      Tag="SectionSelector"
                                                      Style="{StaticResource SectionHeaderCheckBoxStyle}"
                                                      Content="Repair &amp; recovery"
                                                      ToolTip="Check every option in Repair &amp; recovery" />
                                            <CheckBox x:Name="CbAdvRestartWindowsExplorer" Content="Restart Windows Explorer" />
                                            <CheckBox x:Name="CbAdvRebuildWindowsSearchIndex" Content="Rebuild Windows Search index" />
                                            <CheckBox x:Name="CbAdvRunSfcRepair" Content="Run SFC system file repair" />
                                            <CheckBox x:Name="CbAdvRunDismHealthRepair" Content="Run DISM health repair" />
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Help (HIDDEN TAB, BUTTON ONLY) -->
                <TabItem x:Name="TabHelp"
                         Header="Help"
                         Style="{StaticResource UtilityHiddenTabItemStyle}">
                    <Grid Margin="5,10,5,5">
                        <GroupBox Header="Help" Margin="0">
                            <ContentControl x:Name="HelpHost" />
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- Settings (HIDDEN TAB, GEAR ONLY) -->
                <TabItem x:Name="TabSettings"
                         Header="Settings"
                         Style="{StaticResource UtilityHiddenTabItemStyle}">
                    <Grid Margin="5,10,5,5">
                        <GroupBox Header="Settings" Margin="0">
                            <ContentControl x:Name="SettingsHost" />
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- Task results (HIDDEN TAB, LOGS BUTTON ONLY) -->
                <TabItem x:Name="TabLogs"
                         Header="Task Results"
                         Style="{StaticResource UtilityHiddenTabItemStyle}">
                    <Grid Margin="5,10,5,5">
                        <GroupBox Header="Task Results" Margin="0">
                            <ContentControl x:Name="LogsHost" />
                        </GroupBox>
                    </Grid>
                </TabItem>

<!-- Tickets -->
<TabItem x:Name="TabTickets" Header="Tickets">
    <Grid Margin="4">
        <GroupBox Margin="0">

            <GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TicketsHeaderTitleText"
                               Text="Tickets"
                               Foreground="#E5E7EB"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="TicketsSyncStatusText"
                                   Text="Last email check: Never"
                                   Foreground="{StaticResource TextSubtle}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="Visible"
                                   Margin="0,0,8,0" />

                        <Button x:Name="BtnToggleTicketDetails"
                                Width="28"
                                Height="28"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                ToolTip="Back to tickets list">
                            <TextBlock x:Name="TicketDetailsChevron"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE72B;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSubtle}" />
                        </Button>

                        <Button x:Name="BtnNewTicket"
                                Width="28"
                                Height="28"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                ToolTip="New ticket">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE710;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Button x:Name="BtnDeleteTicket"
                                Width="28"
                                Height="28"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                ToolTip="Delete selected ticket">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE74D;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Button x:Name="BtnTicketsFilterMenu"
                                Width="28"
                                Height="28"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                ToolTip="Filter tickets">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE71C;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                    </StackPanel>
                </Grid>
            </GroupBox.Header>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Main grid -->
                <DataGrid x:Name="TicketsGrid"
                          Grid.Row="0"
                          Margin="0"
                          AutoGenerateColumns="False"
                          HeadersVisibility="None"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="None"
                          RowHeight="52"
                          VerticalGridLinesBrush="Transparent"
                          HorizontalGridLinesBrush="Transparent"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="0"
                          Background="{StaticResource CardBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          Foreground="White">

                    <DataGrid.Resources>
                        <Style x:Key="TicketColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#0F172A" />
                            <Setter Property="Foreground" Value="#E5E7EB" />
                            <Setter Property="BorderBrush" Value="#1F2937" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>

                        <Style x:Key="TicketCellStyle" TargetType="{x:Type DataGridCell}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#E5E7EB" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
                        </Style>

                        <Style x:Key="TicketRowStyle" TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="#081327" />
                            <Setter Property="Foreground" Value="#E5E7EB" />
                            <Setter Property="Margin" Value="10,0,10,6" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridRow}">
                                        <Border x:Name="RowCard"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#F59E0B"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="2">
                                            <DataGridCellsPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowCard" Property="Background" Value="#0C1E3C" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowCard" Property="Background" Value="#10233F" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                <Setter TargetName="RowCard" Property="BorderBrush" Value="#16A34A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                <Setter TargetName="RowCard" Property="BorderBrush" Value="#F59E0B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="High">
                                                <Setter TargetName="RowCard" Property="BorderBrush" Value="#F97316" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                <Setter TargetName="RowCard" Property="BorderBrush" Value="#DC2626" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="Normal">
                                                <Setter TargetName="RowCard" Property="BorderBrush" Value="#F59E0B" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>
                        <StaticResource ResourceKey="TicketColumnHeaderStyle" />
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <StaticResource ResourceKey="TicketCellStyle" />
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <StaticResource ResourceKey="TicketRowStyle" />
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*" SortMemberPath="Subject">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1,2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Tag="TicketTitleText"
                                                   Text="{Binding Subject, TargetNullValue=(No subject), FallbackValue=(No subject)}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Grid Grid.Row="1"
                                              Grid.Column="0"
                                              Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Tag="TicketStatusText"
                                                       Text="{Binding Status, TargetNullValue=New, FallbackValue=New}"
                                                       Foreground="#93C5FD"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Tag="TicketAssigneeText"
                                                       Text="{Binding AssignedTo, StringFormat=@{0}, TargetNullValue=@Unassigned, FallbackValue=@Unassigned}"
                                                       Foreground="{StaticResource TextSubtle}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding CreatedAtDisplay}"
                                                       Foreground="{StaticResource TextSubtle}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <TextBlock x:Name="TicketPriorityIcon"
                                                   Grid.Row="1"
                                                   Grid.RowSpan="1"
                                                   Grid.Column="2"
                                                   Tag="TicketPriorityIcon"
                                                   Text="&#xE7BA;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="#F59E0B"
                                                   HorizontalAlignment="Left"
                                                   Margin="2,1,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Priority}" Value="Low">
                                            <Setter TargetName="TicketPriorityIcon" Property="Text" Value="&#xE73E;" />
                                            <Setter TargetName="TicketPriorityIcon" Property="Foreground" Value="#16A34A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                            <Setter TargetName="TicketPriorityIcon" Property="Text" Value="&#xE7BA;" />
                                            <Setter TargetName="TicketPriorityIcon" Property="Foreground" Value="#F59E0B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                            <Setter TargetName="TicketPriorityIcon" Property="Text" Value="&#xE814;" />
                                            <Setter TargetName="TicketPriorityIcon" Property="Foreground" Value="#F97316" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                            <Setter TargetName="TicketPriorityIcon" Property="Text" Value="&#xEA39;" />
                                            <Setter TargetName="TicketPriorityIcon" Property="Foreground" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="Normal">
                                            <Setter TargetName="TicketPriorityIcon" Property="Text" Value="&#xE7BA;" />
                                            <Setter TargetName="TicketPriorityIcon" Property="Foreground" Value="#F59E0B" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1,2,1">
                                        <TextBox x:Name="TicketTitleInlineEditor"
                                                 Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Background="#0F172A"
                                                 Foreground="White"
                                                 BorderBrush="#3B82F6"
                                                 BorderThickness="1"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 Padding="6,3"
                                                 VerticalContentAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="TicketsStartupErrorPanel"
                        Grid.Row="0"
                        Panel.ZIndex="10"
                        Visibility="Collapsed"
                        Margin="14"
                        Padding="16"
                        Background="#111827"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Tickets failed to load"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="TicketsStartupErrorText"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#CBD5E1"
                                   FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Collapsible details drawer -->
                <Border x:Name="TicketDetailsPanel"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Visibility="Collapsed"
                        Background="#0B1220"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Margin="0"
                        Padding="0">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="VerticalOnly">
                        <StackPanel Margin="10">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="TicketContactAvatar"
                                        Width="44"
                                        Height="44"
                                        CornerRadius="22"
                                        Background="#A855F7"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top">
                                    <TextBlock x:Name="TicketContactAvatarText"
                                               Text="--"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Orientation="Vertical"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="TicketContactPrimaryText"
                                               Text="Email sender unavailable"
                                               Foreground="#E5E7EB"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <Ellipse x:Name="TicketContactStatusDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="#6B7280"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0" />
                                        <TextBlock x:Name="TicketContactMetaText"
                                                    Text="Unassigned"
                                                    Foreground="#9CA3AF"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="TicketSummaryHeaderText"
                                           Grid.Column="2"
                                           Foreground="#93C5FD"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="12,0,0,0"
                                           Visibility="Collapsed" />
                            </Grid>
                            <Border Background="#0B1220"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,0,0,10">
                                <StackPanel x:Name="TicketEmailBodyText"
                                            Orientation="Vertical" />
                            </Border>

                            <TextBlock Text="Response"
                                       Foreground="{StaticResource TextSubtle}"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                            <Border Background="#0B1220"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="BtnComposeInternalNote"
                                                Content="Add internal note"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Foreground="#9CA3AF"
                                                Padding="0"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Left" />
                                        <TextBlock Text="/"
                                                   Foreground="#6B7280"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0" />
                                        <Button x:Name="BtnComposeReplyCustomer"
                                                Content="Reply to customer"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Foreground="#60A5FA"
                                                Padding="0"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel x:Name="TicketComposeSubjectRow" Margin="0,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Subject"
                                               Foreground="{StaticResource TextSubtle}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="TicketReplySubject"
                                              Background="#0B1220"
                                              Foreground="White"
                                              BorderBrush="Transparent"
                                              BorderThickness="0"
                                              Margin="0,0,0,8"
                                              Padding="8" />
                                    </StackPanel>
                                    <TextBlock Text="Message"
                                               Foreground="{StaticResource TextSubtle}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="TicketReplyText"
                                              AcceptsReturn="True"
                                              TextWrapping="Wrap"
                                              MinHeight="150"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="#020617"
                                              Foreground="White"
                                              BorderBrush="#334155"
                                              BorderThickness="1"
                                              Padding="8"
                                              Margin="0,0,0,8" />
                                    <TextBlock x:Name="TicketReplyStatusText"
                                               Foreground="#93C5FD"
                                               Visibility="Collapsed"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnSendTicketReply"
                                                Content="Send reply"
                                                Width="160"
                                                HorizontalAlignment="Left"
                                                IsEnabled="False" />
                                        <Button x:Name="BtnRetryFailedTicketReply"
                                                Content="Retry failed reply"
                                                Width="160"
                                                HorizontalAlignment="Left"
                                                Margin="8,0,0,0"
                                                Visibility="Collapsed"
                                                IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

