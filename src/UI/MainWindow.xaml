<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Quinn Optimiser Toolkit"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="94"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Basic colours -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="CardBrush" Color="#020617" />
        <SolidColorBrush x:Key="BorderBrush" Color="#374151" />
        <SolidColorBrush x:Key="TextSubtle" Color="#9CA3AF" />
        <SolidColorBrush x:Key="SoftSeparator" Color="#4B5563" />
        <SolidColorBrush x:Key="QOTMenuBackgroundBrush" Color="#07111F" />
        <SolidColorBrush x:Key="QOTMenuBorderBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="QOTMenuForegroundBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="QOTMenuMutedForegroundBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="QOTMenuHoverBrush" Color="#13233A" />
        <SolidColorBrush x:Key="QOTMenuHoverBorderBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="QOTMenuDisabledForegroundBrush" Color="#64748B" />
        <SolidColorBrush x:Key="QOTMenuSeparatorBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="QOTMenuGlyphBrush" Color="#93C5FD" />

        <Style x:Key="QOTSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1"
                                Background="{StaticResource QOTMenuSeparatorBrush}"
                                CornerRadius="1"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QOTMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource QOTMenuForegroundBrush}" />
            <Setter Property="Padding" Value="10,7,14,7" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ItemBorder"
                                    Margin="{TemplateBinding Margin}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="CheckHost"
                                            Grid.Column="0"
                                            Width="16"
                                            Height="16"
                                            Margin="8,0,4,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#0B1628"
                                            BorderBrush="#22324A"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="Collapsed">
                                        <Path x:Name="CheckGlyph"
                                              Width="8"
                                              Height="6"
                                              Stretch="Fill"
                                              Stroke="{StaticResource QOTMenuGlyphBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M 0 3 L 2.4 5.4 L 8 0"
                                              Visibility="Collapsed" />
                                    </Border>

                                    <ContentPresenter Grid.Column="1"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"
                                                      ContentSource="Header" />

                                    <TextBlock Grid.Column="2"
                                               Margin="14,0,6,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource QOTMenuMutedForegroundBrush}"
                                               FontSize="11"
                                               Text="{TemplateBinding InputGestureText}" />

                                    <Path x:Name="SubmenuArrow"
                                          Grid.Column="3"
                                          Width="6"
                                          Height="10"
                                          Margin="0,0,8,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource QOTMenuMutedForegroundBrush}"
                                          Data="M 0 0 L 6 5 L 0 10 Z"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   HorizontalOffset="-3"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Margin="6,0,0,0"
                                        Background="{StaticResource QOTMenuBackgroundBrush}"
                                        BorderBrush="{StaticResource QOTMenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                                          Direction="270"
                                                          Opacity="0.24"
                                                          ShadowDepth="4"
                                                          Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel Margin="4"
                                                IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsCheckable" Value="True">
                                <Setter TargetName="CheckHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckHost" Property="Background" Value="#102847" />
                                <Setter TargetName="CheckHost" Property="BorderBrush" Value="{StaticResource QOTMenuHoverBorderBrush}" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource QOTMenuHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource QOTMenuHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource QOTMenuHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource QOTMenuHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource QOTMenuDisabledForegroundBrush}" />
                                <Setter TargetName="CheckHost" Property="Opacity" Value="0.45" />
                                <Setter TargetName="SubmenuArrow" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QOTContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{StaticResource QOTMenuBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource QOTMenuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource QOTMenuForegroundBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource QOTMenuItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="Transparent"
                                Padding="6"
                                SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20"
                                                      Direction="270"
                                                      Opacity="0.26"
                                                      ShadowDepth="5"
                                                      Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True">
                                    <StackPanel Margin="4"
                                                IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Simple button style -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Primary CTA button (used for Run selected actions) -->
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"

                                CornerRadius="5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder"
                                        Property="Background"
                                        Value="#1D4ED8" />
                                <Setter TargetName="buttonBorder"
                                        Property="BorderBrush"
                                        Value="#1D4ED8" />
                                <Setter TargetName="buttonBorder"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared toolbar icon button (Play / Help / Settings) -->
        <Style x:Key="ToolbarIconButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#1F2937" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#4B5563" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#111827" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#6B7280" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowChromeButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#111827" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#1F2937" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#A1271A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GroupBox style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header bar -->
                            <Border Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    Padding="12,4,12,4"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="0,0,0,2">
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Border>

                            <!-- Content card -->
                            <Border Grid.Row="1"
                                    Margin="0,4,0,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Margin="12,10,12,10"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section heading style -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SectionHeaderCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="HeaderHost"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="0,2,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />

                                <Border x:Name="CheckHost"
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Margin="8,0,0,0"
                                        CornerRadius="2"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="CheckGlyph"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="#60A5FA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderHost" Property="Background" Value="#0B1220" />
                                <Setter TargetName="CheckHost" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="HeaderHost" Property="Background" Value="#10233F" />
                                <Setter TargetName="CheckHost" Property="Background" Value="#0B1F3B" />
                                <Setter TargetName="CheckHost" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="HeaderHost" Property="Background" Value="#111827" />
                                <Setter TargetName="CheckHost" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="CheckGlyph" Property="Text" Value="&#xE738;" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderHost" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="4,2,0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarCheckActionStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="RailIconButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#223046" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#132033" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#35507A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#0B1628" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#4E6EA0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#10233F" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailIconCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#223046" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#132033" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#35507A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#0B1628" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#4E6EA0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#10233F" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailItemHost"
               TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="RailSubIconButton"
               TargetType="Button"
               BasedOn="{StaticResource RailIconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderBrush" Value="#20314B" />
            <Setter Property="Foreground" Value="#93C5FD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="#0B1628"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#13233A" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#0A1A30" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Softer separators -->
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="0,8,0,8" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource SoftSeparator}" />
        </Style>

        <!-- Tabs -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1F2937" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4B5563" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Utility tab style (Help/Settings): selectable via code, never shown in tab strip -->
        <Style x:Key="UtilityHiddenTabItemStyle"
               TargetType="TabItem"
               BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Width="0" Height="0" Visibility="Collapsed" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid style (global) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#020617" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="RowBackground" Value="#020617" />
            <Setter Property="AlternatingRowBackground" Value="#020617" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#020617" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B1220" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#020617" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="Padding" Value="6,3" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Background="#0F172A"
            BorderBrush="#111827"
            BorderThickness="1">
        <Grid Background="#0F172A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title/header -->
            <Border Grid.Row="0"
                    Background="#020617"
                    BorderBrush="#111827"
                    BorderThickness="0,0,0,1">
                <Grid x:Name="CustomTitleBarHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image x:Name="WindowTitleIcon"
                           Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="0"
                           Width="50"
                           Height="50"
                           Margin="14,0,12,0"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="Fant" />

                    <Grid x:Name="WindowDragSurface"
                          Grid.Row="0"
                          Grid.Column="1"
                          Background="Transparent">
                    </Grid>

                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnWindowMinimize"
                                Style="{StaticResource WindowChromeButton}"
                                ToolTip="Minimise">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Text="&#xE921;" />
                        </Button>
                        <Button x:Name="BtnWindowMaximize"
                                Style="{StaticResource WindowChromeButton}"
                                ToolTip="Maximise">
                            <TextBlock x:Name="BtnWindowMaximizeGlyph"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Text="&#xE922;" />
                        </Button>
                        <Button x:Name="BtnWindowClose"
                                Style="{StaticResource WindowCloseButton}"
                                ToolTip="Close">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>

                    <Grid x:Name="HeaderContentDragSurface"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="1"
                          Margin="0,0,10,2"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Quinn Optimiser Toolkit"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SummaryText"
                                       Text="System summary will appear here"
                                       Foreground="{StaticResource TextSubtle}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ExecutionMessage"
                                       Text=""
                                       Foreground="#FCA5A5"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main tabs -->
            <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#09111F"
                    BorderBrush="#1F2937"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="4,6">
                <Grid x:Name="RailShellGrid">
                    <ScrollViewer VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel x:Name="RailIconHost"
                                    AllowDrop="True">
                        <Border Style="{StaticResource RailItemHost}" Tag="BtnNavCleaning">
                            <Button x:Name="BtnNavCleaning"
                                    Style="{StaticResource RailIconButton}"
                                    Tag="Inactive"
                                    ToolTip="Tweaks &amp; Cleaning">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Text="&#xE74D;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Border>
                        <Border Style="{StaticResource RailItemHost}" Tag="BtnNavApps">
                            <Button x:Name="BtnNavApps"
                                    Style="{StaticResource RailIconButton}"
                                    Tag="Inactive"
                                    ToolTip="Apps">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Text="&#xE71D;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Border>
                        <Border Style="{StaticResource RailItemHost}" Tag="BtnNavAdvanced">
                            <Button x:Name="BtnNavAdvanced"
                                    Style="{StaticResource RailIconButton}"
                                    Tag="Inactive"
                                    ToolTip="Advanced">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Text="&#xE7BE;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Border>
                        <Border Style="{StaticResource RailItemHost}" Tag="BtnNavTickets">
                            <Button x:Name="BtnNavTickets"
                                    Style="{StaticResource RailIconButton}"
                                    Tag="Inactive"
                                    ToolTip="Tickets">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Text="&#xE8BD;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Border>

                        <Border Style="{StaticResource RailItemHost}" Tag="CbQuickSafeCleanup">
                            <CheckBox x:Name="CbQuickSafeCleanup"
                                      Style="{StaticResource RailIconCheckBoxStyle}"
                                      Tag="&#xE117;"
                                      Content="Quick clean"
                                      ToolTip="Run safe cleanup now" />
                        </Border>

                        <Border Style="{StaticResource RailItemHost}" Tag="BtnPlay">
                            <Button x:Name="BtnPlay"
                                    Style="{StaticResource RailIconButton}"
                                    IsEnabled="True"
                                    ToolTip="Run selected actions">
                                <Grid Width="34" Height="34" ClipToBounds="True">
                                    <Path x:Name="BtnPlayProgressPath"
                                          Data="M0,0 L34,0 L34,34 L0,34 Z"
                                          Fill="{StaticResource AccentBrush}"
                                          Stretch="Fill">
                                        <Path.Clip>
                                            <RectangleGeometry x:Name="BtnPlayProgressClip"
                                                               Rect="0,0,0,34" />
                                        </Path.Clip>
                                    </Path>
                                    <TextBlock x:Name="BtnPlayIcon"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Text="&#xE768;"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </Border>

                        <Border Style="{StaticResource RailItemHost}" Tag="BtnLogs">
                            <Button x:Name="BtnLogs"
                                    Style="{StaticResource RailIconButton}"
                                    ToolTip="View task results">
                                <TextBlock x:Name="BtnLogsIcon"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Text="&#xE8A5;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Border>

                        <Border Style="{StaticResource RailItemHost}" Tag="BtnHelp">
                            <Button x:Name="BtnHelp"
                                    Style="{StaticResource RailIconButton}"
                                    Tag="Inactive"
                                    ToolTip="Help">
                                <TextBlock x:Name="BtnHelpIcon"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Text="&#xE897;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Border>

                        <Border Style="{StaticResource RailItemHost}" Tag="BtnSettings" Margin="0">
                            <Button x:Name="BtnSettings"
                                    Style="{StaticResource RailIconButton}"
                                    Tag="Inactive"
                                    ToolTip="Settings">
                                <TextBlock x:Name="BtnSettingsIcon"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Text="&#xE713;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="TicketsRailSubmenu"
                            Visibility="Collapsed"
                            Width="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0"
                            Panel.ZIndex="30"
                            Background="#08111F"
                            BorderBrush="#20314B"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="2,4">
                        <StackPanel>
                            <Button x:Name="BtnRailTicketBack"
                                    Style="{StaticResource RailSubIconButton}"
                                    ToolTip="Back to tickets list">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Text="&#xE72B;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="BtnRailTicketNew"
                                    Style="{StaticResource RailSubIconButton}"
                                    ToolTip="New ticket">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Text="&#xE710;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="BtnRailTicketDelete"
                                    Style="{StaticResource RailSubIconButton}"
                                    ToolTip="Delete selected ticket">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Text="&#xE74D;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="BtnRailTicketFilter"
                                    Style="{StaticResource RailSubIconButton}"
                                    Margin="0"
                                    ToolTip="Filter tickets">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Text="&#xE71C;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Column="2" x:Name="MainContentHost">
            <TabControl x:Name="MainTabControl"
                        Background="#0F172A"
                        BorderBrush="#111827"
                        BorderThickness="1"
                        Padding="0">
                <TabControl.Resources>
                    <Style TargetType="{x:Type TabPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <!-- Tweaks & Cleaning -->
                <TabItem x:Name="TabCleaning" Header="Tweaks &amp; Cleaning">
                    <TabItem.Resources>
                        <DataTemplate x:Key="RichCheckRowContentTemplate">
                            <Border x:Name="RowCard"
                                    Background="#0B1220"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="56"
                                    Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconGlyph"
                                               Grid.Column="0"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE74D;"
                                               Foreground="#93C5FD"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <StackPanel Grid.Column="1"
                                                Margin="2,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=ToolTip}"
                                                   Foreground="{StaticResource TextSubtle}"
                                                   FontSize="11"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="StateGlyph"
                                                Grid.Column="2"
                                                FontFamily="Segoe MDL2 Assets"
                                                Text="&#xE73E;"
                                                FontSize="13"
                                                Foreground="#60A5FA"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Visibility="Collapsed" />
                                    <Grid x:Name="ToggleSwitchHost"
                                          Grid.Column="2"
                                          Width="34"
                                          Height="18"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0"
                                          Visibility="Collapsed">
                                        <Border x:Name="ToggleTrack"
                                                Background="#374151"
                                                BorderBrush="#6B7280"
                                                BorderThickness="1"
                                                CornerRadius="9" />
                                        <Ellipse x:Name="ToggleThumb"
                                                 Width="12"
                                                 Height="12"
                                                 Fill="#E5E7EB"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Margin="2,0,0,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=IsChecked}" Value="True">
                                    <Setter TargetName="RowCard" Property="Background" Value="#10233F" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakTipsInStart">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakStartMenuRecommendations">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakSuggestedApps">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakBingSearch">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakClassicContextMenu">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakWidgets">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakNewsAndInterests">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakMeetNow">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakAdvertisingId">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakFeedbackHub">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakOnlineTips">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakDisableLockScreenTips">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakDisableSettingsSuggestedContent">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakDisableTransparencyEffects">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakDisableStartupDelay">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakDisableGameDVR">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakDisableWindowsConsumerFeatures">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakDisableWindowsRecall">
                                    <Setter TargetName="ToggleSwitchHost" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=IsChecked}" Value="True" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakStartMenuRecommendations" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ToggleTrack" Property="Background" Value="#2563EB" />
                                    <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#2563EB" />
                                    <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,2,0" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=IsChecked}" Value="True" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=Tag}" Value="Invoke-QTweakSuggestedApps" />
