                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowHost" Property="Background" Value="#091628" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="RowHost" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
